<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>Velin</title>
    <welcome>Velin is a block-based Markdown editor built with Rust and GPUI.</welcome>
    <options customize="never" require-scripts="true" rootVolumeOnly="true"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="10.15"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="default">
            <line choice="Velin"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="Velin" title="Install Velin" description="Install Velin to /Applications">
        <pkg-ref id="eu.zilinski.Velin"/>
    </choice>
    <pkg-ref id="eu.zilinski.Velin" version="__VELIN_VERSION__" onConclusion="none">#Velin-component.pkg</pkg-ref>
</installer-gui-script>
